KIS_APP_KEY=
KIS_APP_SECRET=
# 실전 REST: https://openapi.koreainvestment.com:9443
# 모의 REST: https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=
# WebSocket (모의/실전 동일 호스트인 경우 많음): ws://ops.koreainvestment.com:21000
KIS_WEBSOCKET_URL=

# WebSocket 구독 풀 (미작성 시 기본값: max=40, demand=8, reserved=10, 재배치 180초)
# KIS_WEBSOCKET_MAX_SUBSCRIPTIONS=
# KIS_WEBSOCKET_DEMAND_SLOTS=
# KIS_WEBSOCKET_RESERVED_TRADING_SLOTS=
# KIS_WEBSOCKET_DEMAND_RECENT_MINUTES=
# KIS_WEBSOCKET_REBALANCE_DELAY_MS=
# KIS_WEBSOCKET_REBALANCE_INITIAL_DELAY_MS=

# 시세 새로고침 시간 설정: DB fresh TTL(ms), Redis 공유 캐시 TTL(초), 로컬 캐시 TTL(ms) 미작성시 기본값 사용
# application.properties에 작성 시 ${kis.price.db-fresh-ttl-ms} 형식으로 사용

# DB 시세 새로고침 시간(기본값 5000)
KIS_PRICE_DB_FRESH_TTL_MS=
# Redis 공유 캐시 시간(기본값 3)
KIS_PRICE_REDIS_CACHE_TTL_SECONDS=
# Redis 공유 캐시 사용 여부(기본값 true)
KIS_PRICE_REDIS_CACHE_ENABLED=
# 로컬 캐시 시간(기본값 800)
KIS_PRICE_LOCAL_CACHE_TTL_MS=
# REST 참조 시세(고저시가·체결강도) 캐시 TTL(ms, 기본값 60000)
# KIS_PRICE_REFERENCE_CACHE_TTL_MS=

# 메인·구독 stale 제외(분, 기본값 5). 거래대금은 당일 누적(KIS REST) 기준
# KIS_MAIN_REALTIME_FRESH_MINUTES=

# 구독 종목 거래량·거래대금 REST backfill 주기(ms, 기본 30000)
# KIS_REALTIME_VOLUME_BACKFILL_INTERVAL_MS=

# 디테일 호가 H0STASP0 WS 캐시 유효 TTL(ms, 기본 3000)
# KIS_ORDERBOOK_WS_FRESH_TTL_MS=

DART_APP_KEY=

NAVER_APP_KEY=
NAVER_APP_SECRET=

MAIL_USERNAME=
MAIL_PASSSWORD=
